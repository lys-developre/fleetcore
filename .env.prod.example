# Production settings. On the server: cp .env.prod.example .env.prod, fill every value, chmod 600 .env.prod
# Never commit .env.prod (it is git-ignored).
DOMAIN=fleetcore.larryyoffre.com
ACME_EMAIL=
# latest, or a commit SHA published by CI to pin a release
IMAGE_TAG=latest

POSTGRES_DB=fleetcore
POSTGRES_USER=fleetcore
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 32
APP_SECRET=

# sandbox = SMS are stored and shown in the office panel; twilio = real sending
SMS_DRIVER=sandbox
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Used by infra/scripts/backup.sh
BACKUP_DIR=/var/backups/fleetcore
# openssl rand -hex 32
BACKUP_PASSPHRASE=
