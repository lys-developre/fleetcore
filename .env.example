# Copy to .env at the repository root to override compose defaults.
# Every value has a safe development default, so this file is optional.
POSTGRES_DB=fleetcore
POSTGRES_USER=fleetcore
POSTGRES_PASSWORD=fleetcore
POSTGRES_PORT=5432
HTTP_PORT=8080
APP_SECRET=dev-secret-change-me
# sandbox = SMS are stored and shown in the office panel; twilio = real sending
SMS_DRIVER=sandbox
